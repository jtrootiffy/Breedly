{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/bhs/:path*",
      "destination": "https://breedhealthscore.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.svg|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
